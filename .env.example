# VentraAI website configuration. All values are public (NEXT_PUBLIC_*); no secrets belong here.
# Leave blank until confirmed. Blank values keep the site in safe mode: early-access CTAs, no Sign in, noindex.
NEXT_PUBLIC_SITE_DOMAIN=            # e.g. ventraai.com (no https://). Needed for canonical URLs, sitemap and indexing.
NEXT_PUBLIC_APP_URL=                # e.g. https://app.ventraai.com. When set, CTAs open /start/existing and Sign in appears.
NEXT_PUBLIC_EARLY_ACCESS_URL=       # Early-access form (used when the app URL is blank).
NEXT_PUBLIC_CONTACT_EMAIL=          # Shown on /policies; also the early-access fallback (mailto).
NEXT_PUBLIC_LEGAL_ENTITY=           # Registered business name for /policies.
NEXT_PUBLIC_LEGAL_ABN=              # ABN for /policies.
# Indexing also requires VERCEL_ENV=production (set automatically by Vercel on production deployments).
